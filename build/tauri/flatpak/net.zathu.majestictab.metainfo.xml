<component type="desktop-application">
  <id>net.zathu.majestictab</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>MajesticTab</name>
  <summary>Guitar tab viewer</summary>
  <description>
    <p>
      MajesticTab is a fast, modern tablature viewer and practice companion for Guitar Pro files, PDF sheet music, and plain text tabs.
    </p>
    <p>Features include:</p>
    <ul>
      <li>High-quality Guitar Pro score rendering and multi-track audio playback with soundfonts</li>
      <li>Smart PDF tab condensing and page layout optimization</li>
      <li>Integrated YouTube video player synchronized with tabs</li>
      <li>Custom finish themes and palettes</li>
      <li>Offline and local file library support</li>
    </ul>
  </description>
  <launchable type="desktop-id">net.zathu.majestictab.desktop</launchable>
  <url type="homepage">https://github.com/cgarst/MajesticTab</url>
  <url type="bugtracker">https://github.com/cgarst/MajesticTab/issues</url>
