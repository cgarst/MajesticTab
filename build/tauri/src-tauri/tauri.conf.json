{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MajesticTab",
  "version": "1.0.0",
  "identifier": "io.github.cgarst.MajesticTab",
  "build": {
    "frontendDist": "../../../app"
  },
  "app": {
    "windows": [
      {
        "title": "MajesticTab",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}