{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MajesticTab",
  "version": "1.0.0",
  "identifier": "net.zathu.majestictab",
  "build": {
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MajesticTab",
        "width": 1440,
        "height": 960,
        "devtools": false,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "fileAssociations": [
      {
        "ext": ["gp", "gp3", "gp4", "gp5", "gpx"],
        "name": "Guitar Pro Score",
        "description": "Guitar Pro Score File",
        "role": "Viewer",
        "mimeType": "application/x-guitar-pro"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["txt"],
        "name": "Plain Text Tab",
        "description": "Plain Text Tablature",
        "role": "Viewer",
        "mimeType": "text/plain"
      }
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}