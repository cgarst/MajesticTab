{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MajesticTab",
  "version": "1.0.0",
  "identifier": "io.github.cgarst.MajesticTab",
  "build": {
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MajesticTab",
        "width": 1440,
        "height": 960,
        "devtools": false,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}