{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MajesticTab",
  "version": "1.0.0",
  "identifier": "net.zathu.majestictab",
  "build": {
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MajesticTab",
        "width": 1280,
        "height": 800,
        "devtools": false,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/linux/16x16.png",
      "icons/linux/24x24.png",
      "icons/linux/32x32.png",
      "icons/linux/48x48.png",
      "icons/linux/64x64.png",
      "icons/linux/128x128.png",
      "icons/linux/256x256.png",
      "icons/linux/512x512.png",
      "icons/windows/icon.ico",
      "icons/macos/icon.icns"
    ],
    "category": "Education",
    "fileAssociations": [
      {
        "ext": ["gp", "gp3", "gp4", "gp5", "gpx"],
        "name": "Guitar Pro Score",
        "description": "Guitar Pro Score File",
        "role": "Viewer",
        "mimeType": "application/x-guitar-pro"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["txt"],
        "name": "Plain Text Tab",
        "description": "Plain Text Tablature",
        "role": "Viewer",
        "mimeType": "text/plain"
      }
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}