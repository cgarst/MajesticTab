{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "ios-icloud",
  "description": "File access to the app's iCloud Drive container for sync (iOS only)",
  "windows": ["main"],
  "platforms": ["iOS"],
  "permissions": [
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
