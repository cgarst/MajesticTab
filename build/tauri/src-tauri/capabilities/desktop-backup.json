{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-backup",
  "description": "Folder chooser and file access for local incremental backups (desktop only)",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "dialog:allow-open",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
