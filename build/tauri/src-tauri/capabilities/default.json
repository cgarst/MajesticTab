{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main MajesticTab window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}