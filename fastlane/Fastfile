# Google Play lanes. Listing images come from fastlane/metadata/android, which is also what F-Droid
# reads. Its descriptions and changelogs are symlinks to support/listing (see build/release-notes.mjs).
# Build the AAB first: node build/build-tauri.mjs android --channel=play
#
# Credentials: PLAY_SERVICE_ACCOUNT_JSON=<path to service account key>
# The Play API has no desktop (ChromeOS) screenshot type, so those stay in Play Console.

default_platform(:android)

platform :android do
  desc "Sync the Play listing (text and images) without uploading a build"
  lane :listing do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Upload the AAB, debug symbols and changelog, and sync the listing"
  lane :release do |options|
    # Fastlane runs lanes from fastlane/, so resolve globs against the repo root.
    root = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
    aab = Dir[File.expand_path(options[:aab] || "dist/*.aab", root)].first or UI.user_error!("No AAB found; build the play channel first")
    symbols = Dir[File.expand_path(options[:symbols] || "dist/*-symbols.zip", root)].first
    status = ENV["PLAY_RELEASE_STATUS"] || "completed"
    # Upload to internal testing, then copy that release to the closed track ("alpha" is
    # Closed testing - Alpha). Set PLAY_PROMOTE_TO=production once the listing is live.
    upload_to_play_store(
      aab: aab,
      mapping_paths: symbols ? [symbols] : nil,
      track: ENV["PLAY_TRACK"] || "internal",
      release_status: status,
      version_name: options[:release_name],
      skip_upload_apk: true
    )
    promote_to = ENV["PLAY_PROMOTE_TO"] || "alpha"
    next if promote_to.empty?
    upload_to_play_store(
      track: ENV["PLAY_TRACK"] || "internal",
      track_promote_to: promote_to,
      release_status: status,
      version_name: options[:release_name],
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

# Apple lanes (App Store Connect). Builds stay in build/build-tauri.mjs; these only upload.
#
# Credentials (an App Store Connect API key, made at App Store Connect > Users and Access > Integrations > App Store Connect API;
# keep them in the gitignored .env, never in the repo):
#   ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_PATH (the downloaded .p8) or ASC_KEY_CONTENT (its text)
#
#   iOS:  IOS_EXPORT_METHOD=app-store-connect APPLE_DEVELOPMENT_TEAM=<team id> IOS_BUILD_NUMBER=<n> \
#           node build/build-tauri.mjs ios --channel=appstore-ios      # writes dist/MajesticTab-ios.ipa
#         bundle exec fastlane ios beta
#   Mac:  APPLE_SIGNING_IDENTITY="Apple Distribution: <name> (<team id>)" APPLE_TEAM_ID=<team id> \
#         MACOS_PROVISIONING_PROFILE=<the Mac App Store .provisionprofile> \
#         MACOS_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: <name> (<team id>)" \
#           node build/build-tauri.mjs macos --channel=appstore-mac --appstore   # writes dist/MajesticTab-appstore.pkg
#         bundle exec fastlane mac beta
#   Set TESTFLIGHT_GROUPS="Group name" on either beta lane to also send the build to those external groups.
#   Listing (text, promotional text and screenshots): bundle exec fastlane ios listing, and mac listing.
#   Text lives in support/listing (symlinked into fastlane/metadata/ios/en-US); screenshots come from support/store/appstore-*/.

APP_STORE_METADATA = "fastlane/metadata/ios".freeze

def asc_api_key
  UI.user_error!("Set ASC_KEY_ID and ASC_ISSUER_ID, and ASC_KEY_PATH or ASC_KEY_CONTENT (see the top of the Apple lanes)") unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && (ENV["ASC_KEY_PATH"] || ENV["ASC_KEY_CONTENT"])
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    key_content: ENV["ASC_KEY_CONTENT"],
    in_house: false
  )
end

# Copy the listed folders' framed screenshots (not raw/) into one folder per locale, which is the layout deliver reads. It picks the
# device slot from each picture's size: 1320x2868 iPhone 6.9", 2064x2752 iPad 13", 2880x1800 Mac. The iPhone Duo set has no slot of its own.
def stage_screenshots(*folders)
  root = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
  dir = File.join(Dir.mktmpdir("appstore-screenshots"), "en-US")
  FileUtils.mkdir_p(dir)
  folders.each do |folder|
    Dir[File.join(root, "support/store", folder, "[0-9][0-9]-*.png")].sort.each { |f| FileUtils.cp(f, File.join(dir, "#{folder}-#{File.basename(f)}")) }
  end
  UI.user_error!("No screenshots found in #{folders.join(', ')}; run support/tools/simulator_screenshots.py") if Dir[File.join(dir, "*.png")].empty?
  File.dirname(dir)
end

def newest_build(pattern, what)
  root = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
  Dir[File.join(root, pattern)].max_by { |f| File.mtime(f) } or UI.user_error!("No #{what} found at #{pattern}; build it first (see the top of the Apple lanes)")
end

def release_notes_for_current_version
  root = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
  version = JSON.parse(File.read(File.join(root, "build/tauri/src-tauri/tauri.conf.json")))["version"]
  { "en-US" => File.read(File.join(root, "support/listing/changelogs/#{version}.txt")).strip }
end

# TestFlight options shared by both beta lanes. TESTFLIGHT_GROUPS (comma-separated external group names, exactly as in App Store
# Connect) turns on external distribution: the lane then waits for processing, adds the build to those groups with the release
# notes as "What to test" and submits it to Beta App Review. Without it the lane only uploads. Export compliance is answered by
# ITSAppUsesNonExemptEncryption in Info.plist, so builds are not held for it.
def testflight_distribution_options
  groups = (ENV["TESTFLIGHT_GROUPS"] || "").split(",").map(&:strip).reject(&:empty?)
  return { skip_waiting_for_build_processing: true } if groups.empty?
  {
    skip_waiting_for_build_processing: false,
    distribute_external: true,
    groups: groups,
    changelog: release_notes_for_current_version["en-US"][0, 4000],
    reject_build_waiting_for_review: false
  }
end

platform :ios do
  desc "Upload dist/MajesticTab-ios.ipa to TestFlight (App Store Connect processes it, then it can be submitted)"
  lane :beta do |options|
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: options[:ipa] ? File.expand_path(options[:ipa], File.expand_path("..", FastlaneCore::FastlaneFolder.path)) : newest_build("dist/*.ipa", "iOS .ipa"),
      **testflight_distribution_options
    )
  end

  desc "Sync the iOS and iPad listing: text, promotional text and screenshots (no build, no submission)"
  lane :listing do
    deliver(
      api_key: asc_api_key,
      platform: "ios",
      metadata_path: APP_STORE_METADATA,
      screenshots_path: stage_screenshots("appstore-ios", "appstore-ipad"),
      release_notes: release_notes_for_current_version,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end
end

platform :mac do
  desc "Upload dist/MajesticTab-appstore.pkg to TestFlight for macOS"
  lane :beta do |options|
    upload_to_testflight(
      api_key: asc_api_key,
      pkg: options[:pkg] ? File.expand_path(options[:pkg], File.expand_path("..", FastlaneCore::FastlaneFolder.path)) : newest_build("dist/*.pkg", "Mac .pkg"),
      app_platform: "osx",
      **testflight_distribution_options
    )
  end

  desc "Sync the Mac listing: text, promotional text and screenshots (no build, no submission)"
  lane :listing do
    deliver(
      api_key: asc_api_key,
      platform: "osx",
      metadata_path: APP_STORE_METADATA,
      screenshots_path: stage_screenshots("appstore-mac"),
      release_notes: release_notes_for_current_version,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end
end
